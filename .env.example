# Discord
TOKEN=
PREFIX=
# Channel id that receives startup notices and error reports
DEVCHANNEL=
# Optional: channel id that receives /feedback (falls back to DEVCHANNEL)
FEEDBACKCHANNEL=
# Discord user id of the bot owner (for /dev add_staff and /dev stop)
OWNER=
# Channel id where the bot keeps images such as character avatars, in a server only the bot's staff can see.
# The bot needs Send Messages, Attach Files and Read Message History there. Without it characters have no picture.
STORAGE_CHANNEL=

# Database
DB_TYPE=postgresql+psycopg2
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dawnbot

# Runtime
# TRUE: run under uvicorn (run.bat). Anything else: main.py runs the bot directly.
API=TRUE
# Token callers must send as X-Auth-Token to the API routes
API_TOKEN=
DEBUG=FALSE
SENTRY_DSN=
# Optional: link on the "Setup Guide" button of permission notices
PERMISSIONS_GUIDE_URL=

# Optional: scene summaries drafted by a local model (classes/scenes/AutoSummary.py). Leave OLLAMA_URL empty to turn
# them off. Ollama only listens on the server itself by default, which is what you want.
OLLAMA_URL=http://127.0.0.1:11434
SUMMARY_MODEL=qwen3:4b-instruct-2507-q4_K_M
# CPU threads the model may use per summary; leave some cores for the bot and database.
SUMMARY_THREADS=4
