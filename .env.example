# Discord
TOKEN=
PREFIX=
# Channel id that receives startup notices and error reports
DEVCHANNEL=
# Discord user id of the bot owner (for /dev add_staff and /dev stop)
OWNER=

# Database
DB_TYPE=postgresql+psycopg2
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dawnbot

# Runtime
# TRUE: run under uvicorn (run.bat). Anything else: main.py runs the bot directly.
API=TRUE
# Token callers must send as X-Auth-Token to the API routes
API_TOKEN=
DEBUG=FALSE
SENTRY_DSN=
# Optional: link on the "Setup Guide" button of permission notices
PERMISSIONS_GUIDE_URL=
